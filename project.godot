; Engine configuration file.
; Godot 4.7 — Pustle (mobile port of Pimple Popper)

config_version=5

[application]

config/name="Pustle"
config/version="0.1.0"
config/description="A touch game about clearing skin protuberances."
run/main_scene="res://menu/new_main_screen.tscn"
config/icon="res://icon.png"

[autoload]

Mobile="*res://mobile/Mobile.gd"
ManagerBilling="*res://singleton/ManagerBilling.gd"
ManagerPlayGames="*res://singleton/ManagerPlayGames.gd"
Global="*res://Global.gd"
Save="*res://singleton/Save.gd"
Yodo="*res://singleton/yodo.tscn"
Capture="*res://tools/capture.gd"

[display]

window/size/viewport_width=1220
window/size/viewport_height=540
window/size/window_width_override=2340
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/translation.af.translation", "res://assets/i18n/translation.ar.translation", "res://assets/i18n/translation.ca.translation", "res://assets/i18n/translation.cs.translation", "res://assets/i18n/translation.da.translation", "res://assets/i18n/translation.de.translation", "res://assets/i18n/translation.el.translation", "res://assets/i18n/translation.en.translation", "res://assets/i18n/translation.es.translation", "res://assets/i18n/translation.fi.translation", "res://assets/i18n/translation.fr.translation", "res://assets/i18n/translation.he.translation", "res://assets/i18n/translation.hu.translation", "res://assets/i18n/translation.it.translation", "res://assets/i18n/translation.ja.translation", "res://assets/i18n/translation.ko.translation", "res://assets/i18n/translation.nl.translation", "res://assets/i18n/translation.nn_NO.translation", "res://assets/i18n/translation.pl.translation", "res://assets/i18n/translation.pt.translation", "res://assets/i18n/translation.pt_BR.translation", "res://assets/i18n/translation.ro.translation", "res://assets/i18n/translation.ru.translation", "res://assets/i18n/translation.si.translation", "res://assets/i18n/translation.sr.translation", "res://assets/i18n/translation.sv.translation", "res://assets/i18n/translation.tr.translation", "res://assets/i18n/translation.uk.translation", "res://assets/i18n/translation.vi.translation", "res://assets/i18n/translation.zh_CN.translation", "res://assets/i18n/translation.zh_TW.translation")
locale/translation_remaps={
"res://assets/win_title/win_en.png": PackedStringArray("res://assets/win_title/win_de.png:de", "res://assets/win_title/won_es.png:es")
}

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_environment="res://default_env.tres"
